{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "esModuleInterop": true, "skipLibCheck": true, "composite": true,
    "baseUrl": ".", "paths": { "@shared/*": ["src/shared/*"], "@/*": ["src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/renderer/src/env.d.ts", "src/shared/**/*", "src/preload/index.ts"]
}
